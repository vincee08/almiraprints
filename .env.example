# Copy to .env.local. Only NEXT_PUBLIC_ values may reach the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never use this key in a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=
# Contact messages only. SMTP is not needed for quote requests.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender address authorized by your SMTP provider (address only).
SMTP_FROM=
# The actual staff inbox. Set explicitly for deployment.
SMTP_TO=
